#!/bin/sh

get_query_value() {
  key="$1"
  printf '%s' "$QUERY" | tr '&' '\n' | sed -n "s/^${key}=//p" | head -n 1
}

urldecode() {
  value="$1"
  value="$(printf '%s' "$value" | sed 's/+/ /g; s/%/\\x/g')"
  printf '%b' "$value"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\n/\\n/g'
}

pid_is_running() {
  pid="$1"
  [ -n "${pid:-}" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

stop_pidfile_job() {
  pid_file="$1"
  lock_dir="${2:-}"

  [ -f "$pid_file" ] || return 0
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if pid_is_running "$pid"; then
    kill "$pid" 2>/dev/null || true
    sleep 1
    pid_is_running "$pid" && kill -9 "$pid" 2>/dev/null || true
  fi

  rm -f "$pid_file"
  [ -n "${lock_dir:-}" ] && rmdir "$lock_dir" >/dev/null 2>&1 || true
}

start_single_bg_job() {
  pid_file="$1"
  log_file="$2"
  lock_dir="${3:-}"
  shift 3

  mkdir -p /var/run/obhodiq
  stop_pidfile_job "$pid_file" "$lock_dir"
  "$@" >"$log_file" 2>&1 &
  bg_pid="$!"
  printf '%s\n' "$bg_pid" > "$pid_file"
}

QUERY="${QUERY_STRING:-}"
[ -n "$QUERY" ] || case "${REQUEST_URI:-}" in
  *\?*) QUERY="${REQUEST_URI#*\?}" ;;
esac

if [ "${REQUEST_METHOD:-GET}" = "POST" ]; then
  if [ -n "${CONTENT_LENGTH:-}" ] && [ "${CONTENT_LENGTH:-0}" -gt 0 ] 2>/dev/null; then
    POST_DATA="$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null || true)"
  else
    POST_DATA="$(cat || true)"
  fi

  if [ -n "${POST_DATA:-}" ]; then
    if [ -n "$QUERY" ]; then
      QUERY="$QUERY&$POST_DATA"
    else
      QUERY="$POST_DATA"
    fi
  fi
fi

cmd="$(get_query_value cmd)"
id="$(get_query_value id)"
mode="$(get_query_value mode)"
group="$(get_query_value group)"
url="$(get_query_value url)"
schedule="$(get_query_value schedule)"
enabled="$(get_query_value enabled)"
enabled_map="$(get_query_value enabled_map)"
disabled_ids="$(get_query_value disabled_ids)"
lang="$(get_query_value lang)"

id="$(urldecode "$id")"
mode="$(urldecode "$mode")"
group="$(urldecode "$group")"
url="$(urldecode "$url")"
schedule="$(urldecode "$schedule")"
enabled="$(urldecode "$enabled")"
enabled_map="$(urldecode "$enabled_map")"
disabled_ids="$(urldecode "$disabled_ids")"
lang="$(urldecode "$lang")"

echo "Content-Type: application/json"
echo ""

case "$cmd" in
  fetch|parse|refresh|refresh-apply|select-best|select-best-apply|refresh-latency|get-url|get-update-schedule|get-enabled|get-lang|export-active|sync-podkop|write-podkop-apply|apply-podkop|status|list-servers|list-groups)
    /usr/bin/obhodiq "$cmd"
    ;;
  refresh-apply-bg)
    start_single_bg_job \
      /var/run/obhodiq/refresh-apply-bg.pid \
      /tmp/obhodiq-subscription-refresh.log \
      /var/run/obhodiq/command.lock \
      /usr/bin/obhodiq refresh-apply
    printf '{"ok":true,"background":true}\n'
    ;;
  refresh-latency-bg)
    start_single_bg_job \
      /var/run/obhodiq/refresh-latency-bg.pid \
      /tmp/obhodiq-ping-refresh.log \
      /var/run/obhodiq/latency.lock \
      /usr/bin/obhodiq refresh-latency
    printf '{"ok":true,"background":true}\n'
    ;;
  set-url)
    /usr/bin/obhodiq set-url "$url"
    ;;
  set-update-schedule)
    /usr/bin/obhodiq set-update-schedule "$schedule"
    ;;
  set-enabled)
    /usr/bin/obhodiq set-enabled "$enabled"
    ;;
  set-enabled-map)
    /usr/bin/obhodiq set-enabled-map "$enabled_map"
    ;;
  set-disabled-ids)
    /usr/bin/obhodiq set-disabled-ids "$disabled_ids"
    ;;
  set-lang)
    /usr/bin/obhodiq set-lang "$lang"
    ;;
  set-mode)
    /usr/bin/obhodiq set-mode "$mode"
    ;;
  set-active)
    /usr/bin/obhodiq set-active "$id"
    ;;
  set-group)
    /usr/bin/obhodiq set-group "$id" "$group"
    ;;
  set-active-group)
    /usr/bin/obhodiq set-active-group "$group"
    ;;
  exclude)
    /usr/bin/obhodiq exclude "$id"
    ;;
  include)
    /usr/bin/obhodiq include "$id"
    ;;
  *)
    printf '{"ok":false,"message":"unknown or empty command"}\n'
    ;;
esac
